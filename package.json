{
  "name": "chart-akademie",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "gen:meta": "vitest run --config vitest.gen.config.ts",
    "preview": "vite preview",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --port 8787",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:check": "tsc -p worker",
    "macro:holen": "node scripts/macro/hole-macro.ts",
    "macro:push": "node scripts/macro/sende-push.ts",
    "macro:check": "tsc -p scripts/macro",
    "push:keys": "node scripts/macro/vapid-keys.ts",
    "tracker:holen": "tsx scripts/tracker/hole-tracker.ts",
    "tracker:check": "tsc -p scripts/tracker",
    "board:holen": "tsx scripts/board/hole-board.ts",
    "board:check": "tsc -p scripts/board"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "web-push": "^3.6.7",
    "wrangler": "^4.151.1",
    "yahoo-finance2": "^4.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
